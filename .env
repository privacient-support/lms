# ---- LMS (IOMAD 5.1) docker stack ----
# Local development against the native (host) MariaDB.

# Host port for the web container (container listens on 80 internally).
MOODLE_HTTP_PORT=8080

# Site address as the browser sees it. Matches the frontend's IOMAD_API_URL.
MOODLE_WWWROOT=http://localhost:8080

# Database.
# The LMS uses its OWN MariaDB container (lms-mariadb), which joins the external
# `backend` network with the alias `mariadb`. Start it with:  docker start lms-mariadb
MOODLE_DATABASE_HOST=mariadb
MOODLE_DATABASE_PORT=3306
MOODLE_DATABASE_NAME=learning_priv
MOODLE_DATABASE_USER=root
# NOTE: the already-running lms/lms-cron containers carry the real password baked in
# from their original creation, so starting lms-mariadb is enough to run the stack.
# This value only matters if you recreate containers via `docker compose up`.
MOODLE_DATABASE_PASSWORD=REPLACE_WITH_MARIADB_ROOT_PASSWORD
