# ---- LMS (IOMAD 5.1) docker stack ----
#
# Copy to .env and fill in. docker-compose.yml reads these directly.

# Host port for the web container (container itself always listens on 80).
MOODLE_HTTP_PORT=8080

# The site's own address, as a browser sees it. Moodle bakes this into every
# generated URL, so a wrong value here produces a site whose links all point
# somewhere else. Local development: http://localhost:8080
MOODLE_WWWROOT=http://localhost:8080

# Database.
#
# This stack does NOT run its own database service — it joins the external
# `backend` network and resolves the host below on it, which is why the value
# is a container alias and not 127.0.0.1. Create the network once with:
#   docker network create backend
#
# The mariadb container must carry `mariadb` as a network alias on `backend`;
# without it the web container loops on "getaddrinfo for mariadb failed" and
# never starts Apache.
MOODLE_DATABASE_HOST=mariadb
MOODLE_DATABASE_PORT=3306
MOODLE_DATABASE_NAME=learning_priv
MOODLE_DATABASE_USER=root
MOODLE_DATABASE_PASSWORD=change_me
